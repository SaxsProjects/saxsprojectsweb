# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=5000
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/saxsprojects
# The Firebase login that gets admin access in the client portal
ADMIN_EMAIL=saxs.solutions25@gmail.com
# Where new-lead emails go (defaults to ADMIN_EMAIL)
INQUIRY_RECIPIENT_EMAIL=

# --- Website ------------------------------------------------------------------
# Public site URL (used for OAuth redirects)
FRONTEND_URL=https://www.saxsprojects.co.za
# Comma-separated list of sites allowed to call this API from a browser
CORS_ORIGINS=https://www.saxsprojects.co.za,https://saxsprojects.co.za

# --- Email (REQUIRED in production: without it enquiries are rejected so the
# website falls back to WhatsApp/email instead of silently losing the lead) ---
# Zoho Mail:
#   SMTP_HOST=smtppro.zoho.com  for an address on your own domain (e.g. hello@saxsprojects.co.za)
#   SMTP_HOST=smtp.zoho.com     for a free @zoho.com address
#   (accounts in another Zoho region use that region, e.g. smtppro.zoho.eu)
#   SMTP_PASS = an application-specific password from Zoho Accounts > Security > App Passwords
# Test with: npm run check:email
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
# Full mailbox address you log in with
SMTP_USER=
SMTP_PASS=
# Leave empty to send from SMTP_USER (Zoho only allows that address or its verified aliases)
SMTP_FROM=
SMTP_FROM_NAME=SaxsProjects

# --- Firebase Admin (REQUIRED for client portal logins) ----------------------
# One of: paste the service-account JSON (or base64 of it) into
# FIREBASE_SERVICE_ACCOUNT, point FIREBASE_SERVICE_ACCOUNT_PATH at the file
# (e.g. a Render secret file at /etc/secrets/firebase-admin-config.json), or
# place it at backend/firebase-admin-config.json (git-ignored).
# Without it every authenticated route returns 503 in production.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Google Calendar / Meet (optional, for automatic call booking) -----------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Calendar to create events on (share your calendar with the service account)
GOOGLE_CALENDAR_ID=primary

# --- Google sign-in (optional, not used by the website today) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- AI chat autoresponder (optional) ----------------------------------------
GEMINI_API_KEY=

# --- Local development only --------------------------------------------------
# Accept unsigned test tokens when Firebase Admin isn't set up. Ignored when
# NODE_ENV=production. Never enable on a real server.
ALLOW_MOCK_AUTH=false
